{
  "info": {
    "name": "AOS - API de Tarefas (Vercel)",
    "description": "Coleção para testar o back-end publicado na Vercel. A URL base está na variável de coleção {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Tarefas",
      "item": [
        {
          "name": "1. Criar tarefa (POST /tarefas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"objectId\", pm.response.json().objectId);",
                  "pm.test(\"objectId é UUID\", function () { pm.expect(pm.response.json().objectId).to.match(/^[0-9a-f-]{36}$/i); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tarefas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tarefas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Estudar Zod e Express\",\n  \"concluida\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Listar tarefas (GET /tarefas)",
